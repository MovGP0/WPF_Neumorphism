<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Neumorphism.WPF.Theming">
    <Style x:Key="Neumorphism.GridHeaderGripper" TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Neumorphism.GridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="Face" Background="{DynamicResource MaterialDesign.Brush.SurfaceContainer}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.OutlineVariant}" BorderThickness="0,0,0,1" />
                        <DockPanel Margin="12,10">
                            <TextBlock x:Name="SortMark" DockPanel.Dock="Right" Margin="6,0,0,0" />
                            <ContentPresenter RecognizesAccessKey="True" />
                        </DockPanel>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource Neumorphism.GridHeaderGripper}" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource Neumorphism.GridHeaderGripper}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource Neumorphism.Brush.InsetFill}" /></Trigger>
                        <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="SortMark" Property="Text" Value="↑" /></Trigger>
                        <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortMark" Property="Text" Value="↓" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Neumorphism.GridCell" TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="Face" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="11,6">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Neumorphism.Brush.InsetFill}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Error}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Neumorphism.GridRow" TargetType="DataGridRow">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.SurfaceContainer}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Neumorphism.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="{DynamicResource MaterialDesign.Brush.Surface}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource MaterialDesign.Brush.OutlineVariant}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="MinRowHeight" Value="42" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Neumorphism.GridHeader}" />
        <Setter Property="RowStyle" Value="{StaticResource Neumorphism.GridRow}" />
        <Setter Property="CellStyle" Value="{StaticResource Neumorphism.GridCell}" />
    </Style>
</ResourceDictionary>
