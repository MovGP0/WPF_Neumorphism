<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Neumorphism.WPF.Theming">
    <DataTemplate x:Key="Neumorphism.DestinationLabel">
        <StackPanel HorizontalAlignment="Center">
            <Path Data="{Binding Glyph}" Stroke="{DynamicResource MaterialDesign.Brush.OnSurface}"
                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Width="21" Height="21" Stretch="Uniform" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,5,0,0" />
        </StackPanel>
    </DataTemplate>
    <Style x:Key="Neumorphism.DestinationItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Border x:Name="Face" CornerRadius="14" BorderThickness="1" BorderBrush="Transparent" />
                        <Control x:Name="Marker" Style="{StaticResource Neumorphism.SelectionLed}" Height="3" Width="18"
                                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        <ContentPresenter Margin="10,9,10,12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Control Style="{StaticResource Neumorphism.FocusOutline}"
                                 theme:SurfaceChrome.CornerRadius="{Binding CornerRadius, ElementName=Face}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource MaterialDesign.Brush.SurfaceContainerHigh}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Neumorphism.Brush.InsetFill}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Neumorphism.Brush.InsetEdge}" />
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Neumorphism.NavigationList" TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="ItemTemplate" Value="{StaticResource Neumorphism.DestinationLabel}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Neumorphism.DestinationItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style x:Key="Neumorphism.NavigationBar" TargetType="ListBox" BasedOn="{StaticResource Neumorphism.NavigationList}">
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
