<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Neumorphism.WPF.Theming">
    <Style x:Key="Neumorphism.ListSurface" TargetType="ContentControl" BasedOn="{StaticResource Neumorphism.RaisedCard}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <theme:RoundedViewport Radius="22">
                        <ContentPresenter Content="{Binding}" />
                    </theme:RoundedViewport>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Neumorphism.ListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid MinHeight="36" Background="Transparent">
                        <Border x:Name="Face" CornerRadius="8" />
                        <Control x:Name="Marker" Style="{StaticResource Neumorphism.SelectionLed}" Margin="4,0,0,0" />
                        <ContentPresenter Margin="14,5" VerticalAlignment="Center" />
                        <Control Style="{StaticResource Neumorphism.FocusOutline}"
                                 theme:SurfaceChrome.CornerRadius="{Binding CornerRadius, ElementName=Face}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Neumorphism.Brush.InsetFill}" />
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Neumorphism.Brush.ButtonDisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Neumorphism.ListViewItem" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid MinHeight="36" Background="Transparent">
                        <Border x:Name="Face" CornerRadius="8" />
                        <Control x:Name="Marker" Style="{StaticResource Neumorphism.SelectionLed}" Margin="5,0,0,0" />

                        <GridViewRowPresenter Margin="10,0,0,0" Content="{TemplateBinding Content}"
                                              Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}" />
                        <Control Style="{StaticResource Neumorphism.FocusOutline}"
                                 theme:SurfaceChrome.CornerRadius="{Binding CornerRadius, ElementName=Face}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Neumorphism.Brush.InsetFill}" />
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Neumorphism.Brush.ButtonDisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Neumorphism.ListBox" TargetType="ListBox">
        <Setter Property="Padding" Value="5" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Neumorphism.ListBoxItem}" />
    </Style>
    <Style x:Key="Neumorphism.ListView" TargetType="ListView" BasedOn="{StaticResource Neumorphism.ListBox}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Neumorphism.ListViewItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style x:Key="Neumorphism.ListColumn" TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border Padding="14,9,7,9" Background="{DynamicResource MaterialDesign.Brush.SurfaceContainer}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.OutlineVariant}" BorderThickness="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Style="{StaticResource Neumorphism.GridHeaderGripper}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
