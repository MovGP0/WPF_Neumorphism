<UserControl x:Class="Neumorphism.WPF.PaletteEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource MaterialDesign.Brush.OnSurface}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,24">
            <TextBlock Text="Dynamic color" Style="{StaticResource Heading}" />
            <TextBlock Text="Choose a seed color and a scheme to update the gallery."
                       Margin="0,6,0,24" Style="{StaticResource SupportingText}" />

            <Border CornerRadius="22" Padding="18,16" Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.OutlineVariant}" BorderThickness="1">
                <StackPanel>
                    <Label x:Name="SeedLabel" Content="_Seed color" Target="{Binding ElementName=SeedInput}"
                           Padding="0" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.OnSurface}" />
                    <WrapPanel Margin="0,8,0,0">
                        <TextBox x:Name="SeedInput" Width="112" MaxLength="7" Style="{StaticResource ShellInput}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=SeedLabel}"
                                 KeyDown="SeedInput_KeyDown" TextChanged="SeedInput_TextChanged" />
                        <Button Content="_Apply" Style="{StaticResource ShellButton}" Margin="8,0,16,0"
                                Click="ApplySeed_Click" />
                        <ItemsControl x:Name="Presets">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Style="{StaticResource ShellButton}"
                                            ToolTip="{Binding Hex}" Margin="0,0,6,0" Click="Preset_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                    <TextBlock x:Name="SeedError" Text="Enter a six-digit hex color such as #006666."
                               Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{DynamicResource MaterialDesign.Brush.Error}"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="Scheme" Margin="0,16,0,4" FontWeight="SemiBold" />
                    <ListBox x:Name="Variants" DisplayMemberPath="Name" AutomationProperties.Name="Scheme variant"
                             Background="Transparent" BorderThickness="0" Padding="4"
                             ItemContainerStyle="{StaticResource GroupItem}" SelectionChanged="Variants_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </Border>

            <TextBlock Text="Semantic roles" FontWeight="SemiBold" FontSize="20" Margin="0,24,0,10"
                       AutomationProperties.HeadingLevel="Level2" />
            <ItemsControl x:Name="Swatches">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Fill}" CornerRadius="14" Margin="0,0,8,8" Padding="12"
                                BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.OutlineVariant}"
                                MinHeight="70">
                            <StackPanel VerticalAlignment="Center" TextElement.Foreground="{Binding Text}">
                                <TextBlock Text="{Binding Role}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="{Binding Hex}" Margin="0,4,0,0" FontFamily="Consolas" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
