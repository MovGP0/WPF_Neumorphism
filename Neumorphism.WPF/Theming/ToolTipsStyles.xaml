<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Neumorphism.WPF.Theming"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MaxWidth" Value="300" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <ContentControl Style="{StaticResource Neumorphism.RaisedCard}" Margin="9,7,12,12" Padding="12,8"
                                    Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"
                                    theme:SurfaceChrome.CornerRadius="12" theme:SurfaceChrome.Elevation="{x:Static theme:SurfaceElevation.Level2}">
                        <ContentPresenter ContentSource="Content">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </ContentControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
