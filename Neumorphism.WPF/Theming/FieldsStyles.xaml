<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Neumorphism.WPF.Theming">
    <Style x:Key="Neumorphism.Field" TargetType="TextBox" BasedOn="{StaticResource ShellInput}">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style x:Key="Neumorphism.RaisedField" TargetType="TextBox" BasedOn="{StaticResource Neumorphism.Field}">
        <Setter Property="theme:SurfaceChrome.Relief" Value="Raised" />
        <Setter Property="theme:SurfaceChrome.Elevation" Value="{x:Static theme:SurfaceElevation.Level2}" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Surface}" />
    </Style>

    <Style x:Key="Neumorphism.PasswordField" TargetType="PasswordBox" BasedOn="{StaticResource Neumorphism.InputChrome}">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CaretBrush" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
    </Style>

    <Style x:Key="Neumorphism.RaisedPasswordField" TargetType="PasswordBox" BasedOn="{StaticResource Neumorphism.PasswordField}">
        <Setter Property="theme:SurfaceChrome.Relief" Value="Raised" />
        <Setter Property="theme:SurfaceChrome.Elevation" Value="{x:Static theme:SurfaceElevation.Level2}" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Surface}" />
    </Style>
</ResourceDictionary>
