<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StreamGeometry x:Key="Neumorphism.ScrollUp">M 0,3 L 3,0 6,3</StreamGeometry>
    <StreamGeometry x:Key="Neumorphism.ScrollDown">M 0,0 L 3,3 6,0</StreamGeometry>
    <StreamGeometry x:Key="Neumorphism.ScrollLeft">M 3,0 L 0,3 3,6</StreamGeometry>
    <StreamGeometry x:Key="Neumorphism.ScrollRight">M 0,0 L 3,3 0,6</StreamGeometry>

    <Style x:Key="Neumorphism.ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Neumorphism.ScrollArrow" TargetType="RepeatButton" BasedOn="{StaticResource Neumorphism.ScrollPageButton}">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border x:Name="ArrowFace" CornerRadius="6" Margin="2">
                            <Path Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ArrowFace" Property="Background" Value="{DynamicResource MaterialDesign.Brush.SurfaceContainerHigh}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ArrowFace" Property="Background" Value="{DynamicResource Neumorphism.Brush.InsetFill}" />
                            <Setter TargetName="ArrowFace" Property="BorderBrush" Value="{DynamicResource Neumorphism.Brush.InsetEdge}" />
                            <Setter TargetName="ArrowFace" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ArrowFace" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Neumorphism.ScrollWell" TargetType="Border">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Neumorphism.Brush.InsetEdge}" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.SurfaceContainer}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="Neumorphism.ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <Border x:Name="ThumbShadow" CornerRadius="6"
                                    Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerHighest}">
                                <Border.Effect>
                                    <DropShadowEffect Direction="315" ShadowDepth="2" BlurRadius="4"
                                                      Color="{DynamicResource Neumorphism.Color.Shade}"
                                                      Opacity="{DynamicResource Neumorphism.Opacity.Shade}" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="ThumbFace" CornerRadius="6" BorderThickness="1"
                                    Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerHighest}"
                                    BorderBrush="{DynamicResource MaterialDesign.Brush.Outline}" />
                            <Border x:Name="ThumbEdge" CornerRadius="5" Margin="1" BorderThickness="1"
                                    BorderBrush="{DynamicResource Neumorphism.Brush.RaisedEdge}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbFace" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbShadow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ThumbFace" Property="Background" Value="{DynamicResource MaterialDesign.Brush.SurfaceContainerHigh}" />
                            <Setter TargetName="ThumbFace" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <Setter TargetName="ThumbEdge" Property="BorderBrush" Value="{DynamicResource Neumorphism.Brush.InsetEdge}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ThumbShadow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ThumbFace" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.OutlineVariant}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Neumorphism.VerticalScrollBar" TargetType="ScrollBar">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
                <RowDefinition Height="18" />
            </Grid.RowDefinitions>
            <RepeatButton Style="{StaticResource Neumorphism.ScrollArrow}" Command="{x:Static ScrollBar.LineUpCommand}"
                          Content="{StaticResource Neumorphism.ScrollUp}" AutomationProperties.Name="Scroll up" />
            <Border Grid.Row="1" Style="{StaticResource Neumorphism.ScrollWell}" Margin="3,0" />
            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Neumorphism.ScrollPageButton}" Command="{x:Static ScrollBar.PageUpCommand}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource Neumorphism.ScrollThumb}" Padding="4,1" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Neumorphism.ScrollPageButton}" Command="{x:Static ScrollBar.PageDownCommand}" />
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Row="2" Style="{StaticResource Neumorphism.ScrollArrow}" Command="{x:Static ScrollBar.LineDownCommand}"
                          Content="{StaticResource Neumorphism.ScrollDown}" AutomationProperties.Name="Scroll down" />
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="Neumorphism.HorizontalScrollBar" TargetType="ScrollBar">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
            </Grid.ColumnDefinitions>
            <RepeatButton Style="{StaticResource Neumorphism.ScrollArrow}" Command="{x:Static ScrollBar.LineLeftCommand}"
                          Content="{StaticResource Neumorphism.ScrollLeft}" AutomationProperties.Name="Scroll left" />
            <Border Grid.Column="1" Style="{StaticResource Neumorphism.ScrollWell}" Margin="0,3" />
            <Track x:Name="PART_Track" Grid.Column="1">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Neumorphism.ScrollPageButton}" Command="{x:Static ScrollBar.PageLeftCommand}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource Neumorphism.ScrollThumb}" Padding="1,4" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Neumorphism.ScrollPageButton}" Command="{x:Static ScrollBar.PageRightCommand}" />
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Column="2" Style="{StaticResource Neumorphism.ScrollArrow}" Command="{x:Static ScrollBar.LineRightCommand}"
                          Content="{StaticResource Neumorphism.ScrollRight}" AutomationProperties.Name="Scroll right" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Template" Value="{StaticResource Neumorphism.VerticalScrollBar}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Template" Value="{StaticResource Neumorphism.HorizontalScrollBar}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
