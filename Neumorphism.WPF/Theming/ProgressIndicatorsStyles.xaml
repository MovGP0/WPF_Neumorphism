<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Neumorphism.WPF.Theming">
    <Style x:Key="Neumorphism.ProgressBar" TargetType="ProgressBar">
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.SurfaceContainer}" />
        <Setter Property="Tag" Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track" ClipToBounds="True">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Neumorphism.Brush.InsetEdge}" BorderThickness="1" />
                        <Grid x:Name="PART_Indicator" HorizontalAlignment="Left">
                            <Border x:Name="ValueCapsule" Margin="2" CornerRadius="6" Background="{TemplateBinding Foreground}" />
                            <Border x:Name="StaticMark" Width="68" Margin="5,2" CornerRadius="6" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" Visibility="Collapsed" />
                            <Rectangle x:Name="PART_GlowRect" Fill="{TemplateBinding Foreground}" RadiusX="6" RadiusY="6"
                                       HorizontalAlignment="Left" Width="0" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="ValueCapsule" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StaticMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsIndeterminate, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="StaticMark" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_GlowRect" Property="Width" Value="68" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
