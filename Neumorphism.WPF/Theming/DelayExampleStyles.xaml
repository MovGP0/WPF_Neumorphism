<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gallery="clr-namespace:Neumorphism.WPF.Gallery">
    <Style x:Key="DelayLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DelayExample.Brush.Muted}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="DelaySideLabel" TargetType="TextBlock" BasedOn="{StaticResource DelayLabel}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource DelayExample.Brush.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DelayFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="2" CornerRadius="5"
                            BorderBrush="{DynamicResource DelayExample.Brush.AirCore}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="DelayActionTemplate" TargetType="ButtonBase">
        <Border x:Name="Face" CornerRadius="13" Background="{DynamicResource DelayExample.Brush.Well}"
                BorderBrush="{DynamicResource DelayExample.Brush.Edge}" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource DelayExample.Brush.Muted}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource DelayExample.Brush.Bay}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DelayAction" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource DelayFocus}" />
        <Setter Property="Foreground" Value="{DynamicResource DelayExample.Brush.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Template" Value="{StaticResource DelayActionTemplate}" />
    </Style>

    <Style x:Key="DelayModeArrow" TargetType="Button" BasedOn="{StaticResource DelayAction}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Width="26" Height="26" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource DelayExample.Brush.Well}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DelaySwitch" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource DelayFocus}" />
        <Setter Property="Foreground" Value="{DynamicResource DelayExample.Brush.Muted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Face" CornerRadius="12" Background="Transparent" BorderThickness="1"
                            BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource DelayExample.Brush.Muted}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource DelayExample.Brush.Selected}" />
                            <Setter Property="Foreground" Value="{DynamicResource DelayExample.Brush.OnSelected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DelaySwitchFrame" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource DelayExample.Brush.Edge}" />
        <Setter Property="Background" Value="{DynamicResource DelayExample.Brush.Well}" />
    </Style>

    <Style x:Key="DelayLamp" TargetType="ToggleButton">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DelayFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Ellipse Margin="-2" Fill="{DynamicResource DelayExample.Brush.LampSocket}"
                                 Effect="{DynamicResource DelayExample.Effect.LampHighlight}" />
                        <Ellipse x:Name="Halo" Margin="-1" Visibility="Collapsed" Opacity=".64"
                                 Fill="{Binding Accent, RelativeSource={RelativeSource AncestorType=gallery:DelayExamplePage}}">
                            <Ellipse.Effect><BlurEffect Radius="5" /></Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="Cap" Margin="1" Fill="{DynamicResource DelayExample.Brush.LampCap}"
                                 Stroke="{DynamicResource DelayExample.Brush.Well}"
                                 Effect="{DynamicResource DelayExample.Effect.LampShade}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Cap" Property="Margin" Value="2" />
                            <Setter TargetName="Cap" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Cap" Property="Stroke"
                                    Value="{Binding Core, RelativeSource={RelativeSource AncestorType=gallery:DelayExamplePage}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DelayStep" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource DelayFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Background="Transparent" Width="34">
                        <Grid Width="31" Height="31">
                            <Ellipse x:Name="Lamp" Fill="{DynamicResource DelayExample.Brush.Bay}"
                                     Stroke="{DynamicResource DelayExample.Brush.Edge}" />
                            <Ellipse x:Name="Halo" Opacity="0" StrokeThickness="4"
                                     Stroke="{Binding Accent, RelativeSource={RelativeSource AncestorType=gallery:DelayExamplePage}}">
                                <Ellipse.Effect><BlurEffect Radius="5" /></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="Lens" Opacity="0"
                                     Fill="{Binding Spill, RelativeSource={RelativeSource AncestorType=gallery:DelayExamplePage}}"
                                     Stroke="{Binding Core, RelativeSource={RelativeSource AncestorType=gallery:DelayExamplePage}}" />
                        </Grid>
                        <TextBlock Text="⌃" Style="{StaticResource DelayLabel}" Opacity=".5" HorizontalAlignment="Center" Height="12" />
                        <TextBlock x:Name="StepLabel" Text="–" FontFamily="Consolas" FontSize="14" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DelayExample.Brush.Muted}" />
                        <TextBlock Text="⌄" Style="{StaticResource DelayLabel}" Opacity=".5" HorizontalAlignment="Center" Height="12" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource DelayExample.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value=".95" />
                            <Setter TargetName="Lens" Property="Opacity" Value="1" />
                            <Setter TargetName="StepLabel" Property="Text" Value="C" />
                            <Setter TargetName="StepLabel" Property="Foreground"
                                    Value="{Binding Accent, RelativeSource={RelativeSource AncestorType=gallery:DelayExamplePage}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".36" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DelayDialBase" TargetType="gallery:DelayDial">
        <Setter Property="FocusVisualStyle" Value="{StaticResource DelayFocus}" />
        <Setter Property="Cursor" Value="SizeNS" />
        <Setter Property="ToolTip" Value="Drag up or down, or use the arrow keys" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource DelayExample.Brush.Text}" />
    </Style>

    <Style x:Key="DelayReadout" TargetType="gallery:DelayDial" BasedOn="{StaticResource DelayDialBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="gallery:DelayDial">
                    <StackPanel Background="Transparent" VerticalAlignment="Center">
                        <Path Data="M 0,3 L 3,0 6,3" Stroke="{DynamicResource DelayExample.Brush.Muted}"
                              StrokeThickness="1" HorizontalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Center" FontFamily="Consolas" FontSize="{TemplateBinding FontSize}"
                                   Foreground="{Binding Accent, RelativeSource={RelativeSource AncestorType=gallery:DelayExamplePage}}">
                            <Run Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, StringFormat={}{0:0.#}}" /><Run FontSize="10"
                                 Foreground="{DynamicResource DelayExample.Brush.Muted}"
                                 Text="{Binding Unit, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, StringFormat={} {0}}" />
                        </TextBlock>
                        <Path Data="M 0,0 L 3,3 6,0" Stroke="{DynamicResource DelayExample.Brush.Muted}"
                              StrokeThickness="1" HorizontalAlignment="Center" />
                        <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource DelayLabel}" Margin="0,6,0,0"
                                   Foreground="{DynamicResource DelayExample.Brush.Text}" HorizontalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DelayKnob" TargetType="gallery:DelayDial" BasedOn="{StaticResource DelayDialBase}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="gallery:DelayDial">
                    <StackPanel Background="Transparent">
                        <Viewbox Height="{TemplateBinding MinHeight}" Stretch="Uniform">
                            <Grid Width="64" Height="64">
                                <Path Data="{x:Static gallery:DelayDial.Rim}" Fill="{DynamicResource DelayExample.Brush.Well}"
                                      Effect="{DynamicResource DelayExample.Effect.DialHighlight}" />
                                <Path Data="{x:Static gallery:DelayDial.Rim}" Fill="{DynamicResource DelayExample.Brush.Well}"
                                      Effect="{DynamicResource DelayExample.Effect.DialShade}" />
                                <Path x:Name="Rim" Data="{x:Static gallery:DelayDial.Rim}" Stroke="{DynamicResource DelayExample.Brush.Rule}" />
                                <Ellipse Margin="3" Fill="{DynamicResource DelayExample.Brush.DialBevel}" />
                                <Ellipse Margin="8.5" Fill="{DynamicResource DelayExample.Brush.DialFace}"
                                         Stroke="{DynamicResource DelayExample.Brush.Rule}" StrokeThickness=".55" />
                                <Canvas x:Name="Scale" Visibility="Collapsed" IsHitTestVisible="False">
                                    <Path Data="{x:Static gallery:DelayDial.ScaleSockets}" Fill="{DynamicResource DelayExample.Brush.Well}"
                                          Stroke="{DynamicResource DelayExample.Brush.Rule}" StrokeThickness=".5" />
                                    <Path Data="{TemplateBinding ScaleLights}" Opacity=".68"
                                          Fill="{Binding Accent, RelativeSource={RelativeSource AncestorType=gallery:DelayExamplePage}}">
                                        <Path.Effect><BlurEffect Radius="2.5" /></Path.Effect>
                                    </Path>
                                    <Path Data="{TemplateBinding ScaleLights}"
                                          Fill="{Binding Core, RelativeSource={RelativeSource AncestorType=gallery:DelayExamplePage}}" />
                                </Canvas>
                                <Path x:Name="ArcGlow" Data="{TemplateBinding Arc}" StrokeThickness="2.8" Opacity=".7"
                                      Stroke="{Binding Accent, RelativeSource={RelativeSource AncestorType=gallery:DelayExamplePage}}">
                                    <Path.Effect><BlurEffect Radius="2.8" /></Path.Effect>
                                </Path>
                                <Path x:Name="Arc" Data="{TemplateBinding Arc}" StrokeThickness=".9" StrokeEndLineCap="Round"
                                      Stroke="{Binding Accent, RelativeSource={RelativeSource AncestorType=gallery:DelayExamplePage}}" />
                                <Path x:Name="Pointer" Data="M 32,5 L 32,8" StrokeThickness="1.25" StrokeStartLineCap="Round"
                                      Stroke="{Binding Core, RelativeSource={RelativeSource AncestorType=gallery:DelayExamplePage}}">
                                    <Path.RenderTransform>
                                        <RotateTransform CenterX="32" CenterY="32"
                                                         Angle="{Binding Angle, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Path.RenderTransform>
                                </Path>
                                <TextBlock x:Name="Readout" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas"
                                           FontSize="11" Foreground="{DynamicResource DelayExample.Brush.Text}"
                                           Text="{TemplateBinding ReadoutOverride}" />
                            </Grid>
                        </Viewbox>
                        <TextBlock Style="{StaticResource DelayLabel}" HorizontalAlignment="Center" Margin="0,9,0,0">
                            <Run Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" /><Run FontSize="10"
                                 Text="{Binding Unit, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, StringFormat={} {0}}" />
                        </TextBlock>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ReadoutOverride" Value="{x:Null}">
                            <Setter TargetName="Readout" Property="Text"
                                    Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}}" />
                        </Trigger>
                        <Trigger Property="ShowAccent" Value="False">
                            <Setter TargetName="ArcGlow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Arc" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Pointer" Property="Stroke" Value="{DynamicResource DelayExample.Brush.Muted}" />
                        </Trigger>
                        <Trigger Property="ShowScale" Value="True">
                            <Setter TargetName="Scale" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Pointer" Property="Stroke" Value="{DynamicResource DelayExample.Brush.Muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
