<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Neumorphism.WPF.Theming">
    <Style x:Key="Neumorphism.MenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GalleryFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid x:Name="Anchor">
                        <Border x:Name="Row" MinHeight="34" CornerRadius="9" Background="Transparent" Padding="12,6">
                            <DockPanel>
                                <TextBlock x:Name="SubmenuMark" DockPanel.Dock="Right" Text="›" Visibility="Collapsed" Margin="16,0,0,0" />
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               Placement="Bottom" PlacementTarget="{Binding ElementName=Anchor}"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentControl Style="{StaticResource Neumorphism.RaisedCard}" Padding="5" MinWidth="154" Margin="8"
                                            Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}"
                                            theme:SurfaceChrome.CornerRadius="14">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ContentControl>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Right" />
                            <Setter TargetName="SubmenuMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Neumorphism.Brush.InsetFill}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource MaterialDesign.Brush.SurfaceContainerHigh}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Neumorphism.Brush.ButtonDisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Neumorphism.Menu" TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="Neumorphism.ToolBar" TargetType="ToolBar">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolBar">
                    <Grid>
                        <Border CornerRadius="14" Padding="8"
                                Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}"
                                BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.OutlineVariant}">
                            <DockPanel>
                                <ToggleButton x:Name="Overflow" DockPanel.Dock="Right" Content="···" MinWidth="42"
                                              AutomationProperties.Name="More toolbar commands"
                                              IsEnabled="{TemplateBinding HasOverflowItems}"
                                              IsChecked="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                <ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True" />
                            </DockPanel>
                        </Border>
                        <Popup x:Name="OverflowPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=Overflow}"
                               Focusable="False" AllowsTransparency="True" StaysOpen="False"
                               IsOpen="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ContentControl Style="{StaticResource Neumorphism.RaisedCard}" Margin="8" Padding="8"
                                            Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}"
                                            theme:SurfaceChrome.CornerRadius="14">
                                <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel" />
                            </ContentControl>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
