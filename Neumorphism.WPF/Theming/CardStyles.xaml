<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Neumorphism.WPF.Theming">
    <Style x:Key="Neumorphism.Card" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="theme:SurfaceChrome.CornerRadius" Value="22" />
        <Setter Property="theme:SurfaceChrome.Elevation" Value="{x:Static theme:SurfaceElevation.Level3}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Grid x:Name="OuterRelief" IsHitTestVisible="False" Visibility="Collapsed">
                            <theme:ReliefLayer Kind="Highlight" Background="{TemplateBinding Background}"
                                               CornerRadius="{TemplateBinding theme:SurfaceChrome.CornerRadius}"
                                               Elevation="{TemplateBinding theme:SurfaceChrome.Elevation}" />
                            <theme:ReliefLayer Kind="Shade" Background="{TemplateBinding Background}"
                                               CornerRadius="{TemplateBinding theme:SurfaceChrome.CornerRadius}"
                                               Elevation="{TemplateBinding theme:SurfaceChrome.Elevation}" />
                        </Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding theme:SurfaceChrome.CornerRadius}" />
                        <Border x:Name="RaisedEdge" IsHitTestVisible="False" Visibility="Collapsed" BorderThickness="1"
                                BorderBrush="{DynamicResource Neumorphism.Brush.RaisedEdge}"
                                CornerRadius="{TemplateBinding theme:SurfaceChrome.CornerRadius}" />
                        <theme:ReliefLayer x:Name="InnerRelief" Kind="Inset" Visibility="Collapsed" BorderThickness="2"
                                           CornerRadius="{TemplateBinding theme:SurfaceChrome.CornerRadius}"
                                           Elevation="{TemplateBinding theme:SurfaceChrome.Elevation}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="theme:SurfaceChrome.Relief" Value="Raised">
                            <Setter TargetName="OuterRelief" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RaisedEdge" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="theme:SurfaceChrome.Relief" Value="Recessed">
                            <Setter TargetName="InnerRelief" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="theme:SurfaceChrome.Elevation" Value="{x:Static theme:SurfaceElevation.Level0}">
                            <Setter TargetName="OuterRelief" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RaisedEdge" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="InnerRelief" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Neumorphism.RaisedCard" TargetType="ContentControl" BasedOn="{StaticResource Neumorphism.Card}">
        <Setter Property="theme:SurfaceChrome.Relief" Value="Raised" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="Neumorphism.FilledCard" TargetType="ContentControl" BasedOn="{StaticResource Neumorphism.Card}">
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.SurfaceContainer}" />
    </Style>

    <Style x:Key="Neumorphism.OutlinedCard" TargetType="ContentControl" BasedOn="{StaticResource Neumorphism.Card}">
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Outline}" />
    </Style>

    <Style x:Key="Neumorphism.RecessedCard" TargetType="ContentControl" BasedOn="{StaticResource Neumorphism.Card}">
        <Setter Property="theme:SurfaceChrome.Relief" Value="Recessed" />
        <Setter Property="theme:SurfaceChrome.Elevation" Value="{x:Static theme:SurfaceElevation.Level2}" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}" />
    </Style>
</ResourceDictionary>
