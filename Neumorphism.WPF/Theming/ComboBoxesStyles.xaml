<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Neumorphism.WPF.Theming">
    <Style x:Key="Neumorphism.ComboOption" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Background="Transparent" MinHeight="35">
                        <Border x:Name="Well" CornerRadius="8" Visibility="Collapsed"
                                Background="{DynamicResource Neumorphism.Brush.InsetFill}"
                                BorderBrush="{DynamicResource Neumorphism.Brush.InsetEdge}" BorderThickness="1" />
                        <Border x:Name="SelectedMark" Width="3" Height="14" CornerRadius="1.5" Margin="5,0,0,0"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                                Background="{DynamicResource MaterialDesign.Brush.Primary}" />
                        <ContentPresenter Margin="14,5" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Well" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Neumorphism.Brush.ButtonDisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Neumorphism.ComboEditor" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="CaretBrush" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Neumorphism.ComboBox" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Neumorphism.ComboOption}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Face" Grid.ColumnSpan="2" CornerRadius="14" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Outline}" />
                        <Border Grid.ColumnSpan="2" CornerRadius="14" Margin="1" IsHitTestVisible="False"
                                Background="{DynamicResource Neumorphism.Brush.InsetFill}" />
                        <ToggleButton x:Name="Arrow" Grid.ColumnSpan="2" Focusable="False" IsTabStop="False"
                                      AutomationProperties.Name="Open choices"
                                      ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="0,0,15,0">
                                        <Path Data="M 0,0 L 4,4 8,0" Stroke="{DynamicResource MaterialDesign.Brush.OnSurface}"
                                              StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Selected" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <TextBox x:Name="PART_EditableTextBox" Margin="12,0" Visibility="Collapsed"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" Style="{StaticResource Neumorphism.ComboEditor}" />
                        <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom" PlacementTarget="{Binding ElementName=Root}"
                               Focusable="False" AllowsTransparency="True" VerticalOffset="4"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border MinWidth="{Binding ActualWidth, ElementName=Root}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}"
                                    BorderBrush="{DynamicResource Neumorphism.Brush.RaisedEdge}" BorderThickness="1" CornerRadius="14" Padding="5">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="Selected" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Arrow" Property="Grid.Column" Value="1" />
                            <Setter TargetName="Arrow" Property="Grid.ColumnSpan" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <Setter TargetName="Face" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Neumorphism.Brush.ButtonDisabledText}" />
                            <Setter TargetName="Arrow" Property="Opacity" Value=".45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
