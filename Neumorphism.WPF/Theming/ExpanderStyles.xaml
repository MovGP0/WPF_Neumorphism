<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Neumorphism.WPF.Theming">
    <Style x:Key="Neumorphism.ExpanderHeader" TargetType="ToggleButton" BasedOn="{StaticResource Neumorphism.ButtonBase}">
        <Setter Property="theme:SurfaceChrome.Relief" Value="Flat" />
        <Setter Property="theme:SurfaceChrome.CornerRadius" Value="22" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="Neumorphism.Expander" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <ContentControl Style="{StaticResource Neumorphism.RaisedCard}" Padding="0"
                                    theme:SurfaceChrome.Elevation="{x:Static theme:SurfaceElevation.Level1}">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top"
                                          Style="{StaticResource Neumorphism.ExpanderHeader}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <DockPanel>
                                    <Path x:Name="Chevron" DockPanel.Dock="Right" Data="M 0,0 L 4,4 8,0"
                                          Stroke="{DynamicResource MaterialDesign.Brush.OnSurface}" StrokeThickness="1.5"
                                          VerticalAlignment="Center" Margin="12,0,0,0" RenderTransformOrigin="0.5,0.5" />
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                </DockPanel>
                            </ToggleButton>
                            <Border x:Name="Body" Visibility="Collapsed" Padding="16,12"
                                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesign.Brush.OutlineVariant}">
                                <ContentPresenter ContentSource="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                        </DockPanel>
                    </ContentControl>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderSite" Property="Background" Value="{DynamicResource MaterialDesign.Brush.SurfaceContainerHigh}" />
                            <Setter TargetName="HeaderSite" Property="FontWeight" Value="Bold" />
                            <Setter TargetName="HeaderSite" Property="theme:SurfaceChrome.CornerRadius" Value="22,22,0,0" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="180" /></Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="ExpandDirection" Value="Up">
                            <Setter TargetName="HeaderSite" Property="DockPanel.Dock" Value="Bottom" />
                            <Setter TargetName="Body" Property="BorderThickness" Value="0,0,0,1" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="180" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ExpandDirection" Value="Up" />
                                <Condition Property="IsExpanded" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderSite" Property="theme:SurfaceChrome.CornerRadius" Value="0,0,22,22" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="0" /></Setter.Value>
                            </Setter>
                        </MultiTrigger>

                        <Trigger Property="ExpandDirection" Value="Right">
                            <Setter TargetName="HeaderSite" Property="DockPanel.Dock" Value="Left" />
                            <Setter TargetName="Body" Property="BorderThickness" Value="1,0,0,0" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="-90" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ExpandDirection" Value="Right" />
                                <Condition Property="IsExpanded" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderSite" Property="theme:SurfaceChrome.CornerRadius" Value="22,0,0,22" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                            </Setter>
                        </MultiTrigger>

                        <Trigger Property="ExpandDirection" Value="Left">
                            <Setter TargetName="HeaderSite" Property="DockPanel.Dock" Value="Right" />
                            <Setter TargetName="Body" Property="BorderThickness" Value="0,0,1,0" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ExpandDirection" Value="Left" />
                                <Condition Property="IsExpanded" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderSite" Property="theme:SurfaceChrome.CornerRadius" Value="0,22,22,0" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="-90" /></Setter.Value>
                            </Setter>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
