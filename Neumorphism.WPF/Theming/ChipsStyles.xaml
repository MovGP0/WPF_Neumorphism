<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Neumorphism.WPF.Theming">
    <Style x:Key="Neumorphism.Chip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="theme:SurfaceChrome.CornerRadius" Value="16" />
        <Setter Property="theme:SurfaceChrome.Elevation" Value="{x:Static theme:SurfaceElevation.Level1}" />
    </Style>
    <Style x:Key="Neumorphism.SuggestionChip" TargetType="Button" BasedOn="{StaticResource Neumorphism.Chip}">
        <Setter Property="theme:SurfaceChrome.Relief" Value="Flat" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Outline}" />
    </Style>
    <Style x:Key="Neumorphism.FilterChip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="theme:SurfaceChrome.CornerRadius" Value="16" />
        <Setter Property="theme:SurfaceChrome.Elevation" Value="{x:Static theme:SurfaceElevation.Level1}" />
    </Style>
</ResourceDictionary>
