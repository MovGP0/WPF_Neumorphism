<UserControl x:Class="Neumorphism.WPF.Gallery.RatingBarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Neumorphism.WPF.Theming"
             xmlns:gallery="clr-namespace:Neumorphism.WPF.Gallery">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2,12,14,24">
            <TextBlock Text="Set a rating" Style="{StaticResource GallerySection}" />
            <ListBox x:Name="Rating" Style="{StaticResource Neumorphism.RatingBar}" AutomationProperties.Name="Your rating" SelectedIndex="2" />
            <TextBlock Text="{Binding SelectedItem, ElementName=Rating, StringFormat='{}{0} of 5 stars', TargetNullValue='No rating selected'}"
                       Style="{StaticResource SupportingText}" Margin="6,8,0,0" />
            <Button Content="Clear rating" Style="{StaticResource Neumorphism.TextButton}" Click="Clear_Click"
                    HorizontalAlignment="Left" Margin="6,10,0,0" />
            <Border Style="{StaticResource GalleryDivider}">
                <StackPanel>
                    <TextBlock Text="Read-only rating" Style="{StaticResource GallerySection}" />
                    <ListBox x:Name="Review" Style="{StaticResource Neumorphism.RatingBar}" SelectedIndex="3" Focusable="False"
                             IsHitTestVisible="False" KeyboardNavigation.TabNavigation="None" AutomationProperties.Name="Review rating: 4 of 5">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Neumorphism.RatingItem}">
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock Text="4 of 5 stars" Margin="6,8,0,0" Style="{StaticResource SupportingText}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
