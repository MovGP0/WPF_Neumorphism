<UserControl x:Class="Neumorphism.WPF.Gallery.ElevationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Neumorphism.WPF.Theming">
    <UserControl.Resources>
        <Style x:Key="ElevationSwatch" TargetType="ContentControl" BasedOn="{StaticResource Neumorphism.RaisedCard}">
            <Setter Property="MinHeight" Value="76" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="theme:SurfaceChrome.Elevation" Value="{x:Static theme:SurfaceElevation.Level0}">
                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.OutlineVariant}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsChecked, ElementName=InsetToggle}" Value="True">
                    <Setter Property="theme:SurfaceChrome.Relief" Value="Recessed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,8,12,8">
            <DockPanel>
                <ToggleButton x:Name="InsetToggle" DockPanel.Dock="Right" Content="Inset preview" Margin="16,0,0,0" />
                <TextBlock Text="Compare six levels on the same surface color."
                           VerticalAlignment="Center" Style="{StaticResource SupportingText}" />
            </DockPanel>
            <ItemsControl x:Name="Surfaces" ItemsSource="{x:Static theme:SurfaceElevation.Levels}" Margin="0,4,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type theme:SurfaceElevation}">
                        <ContentControl Style="{StaticResource ElevationSwatch}" Margin="14,12,18,16"
                                        theme:SurfaceChrome.Elevation="{Binding}">
                            <StackPanel>
                                <TextBlock Text="{Binding Level, StringFormat=Level {0}}" TextAlignment="Center"
                                           FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource SupportingText}"
                                           TextAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border BorderBrush="{DynamicResource MaterialDesign.Brush.OutlineVariant}" BorderThickness="0,1,0,0"
                    Padding="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Button elevation" FontSize="17" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <WrapPanel Margin="0,2,0,0">
                        <Button x:Name="FlatButton" Content="Level 0" Style="{StaticResource Neumorphism.OutlineButton}"
                                theme:SurfaceChrome.Elevation="{x:Static theme:SurfaceElevation.Level0}"
                                Margin="0,8,16,8" Click="Example_Click" />
                        <Button x:Name="DefaultButton" Content="Level 2 (default)" Margin="0,8,16,8" Click="Example_Click" />
                        <Button x:Name="RaisedButton" Content="Level 4" theme:SurfaceChrome.Elevation="{x:Static theme:SurfaceElevation.Level4}"
                                Margin="0,8,12,8" Click="Example_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="Feedback" Text="Hold Space on a focused raised button to preview its inset."
                               Style="{StaticResource SupportingText}" Margin="0,6,0,0"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
