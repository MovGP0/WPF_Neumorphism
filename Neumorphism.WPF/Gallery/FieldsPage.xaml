<UserControl x:Class="Neumorphism.WPF.Gallery.FieldsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gallery="clr-namespace:Neumorphism.WPF.Gallery">
    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
        </Style>
        <Style x:Key="InlineError" TargetType="TextBlock" BasedOn="{StaticResource SupportingText}">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Error}" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding (Validation.HasError), ElementName=Email}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2,12,14,24">
            <TextBlock Text="Text entry" Style="{StaticResource GallerySection}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Flat" Style="{StaticResource SupportingText}" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Grid.Column="1" Text="Elevated" Style="{StaticResource SupportingText}" FontWeight="SemiBold" Margin="0,0,0,12" />
                <StackPanel Grid.Row="1" Margin="0,0,16,14">
                    <Label x:Name="ProjectLabel" Content="_Project name" Target="{Binding ElementName=Project}" Padding="0,0,0,6" />
                    <TextBox x:Name="Project" Text="Studio refresh" Style="{StaticResource Neumorphism.Field}" AutomationProperties.LabeledBy="{Binding ElementName=ProjectLabel}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,14">
                    <Label Content="Project name" Target="{Binding ElementName=ElevatedProject}" Padding="0,0,0,6" />
                    <TextBox x:Name="ElevatedProject" Text="Studio refresh" Style="{StaticResource Neumorphism.RaisedField}"
                             AutomationProperties.Name="Elevated project name" />
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,16,14">
                    <Label x:Name="PasswordLabel" Content="_Password" Target="{Binding ElementName=Secret}" Padding="0,0,0,6" />
                    <PasswordBox x:Name="Secret" Password="example" Style="{StaticResource Neumorphism.PasswordField}" AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,14">
                    <Label Content="Password" Target="{Binding ElementName=ElevatedSecret}" Padding="0,0,0,6" />
                    <PasswordBox x:Name="ElevatedSecret" Password="example" Style="{StaticResource Neumorphism.RaisedPasswordField}"
                                 AutomationProperties.Name="Elevated password" />
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="0,0,16,0">
                    <Label Content="Read-only reference" Padding="0,0,0,6" />
                    <TextBox Text="REF-204" IsReadOnly="True" Style="{StaticResource Neumorphism.Field}" AutomationProperties.Name="Read-only reference" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,8,0">
                    <Label x:Name="MailLabel" Content="_Email address" Target="{Binding ElementName=Email}" Padding="0,0,0,6" />
                    <TextBox x:Name="Email" Style="{StaticResource Neumorphism.RaisedField}" AutomationProperties.LabeledBy="{Binding ElementName=MailLabel}">
                        <TextBox.Text>
                            <Binding Path="Address" RelativeSource="{RelativeSource AncestorType=gallery:FieldsPage}" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules><gallery:EmailAddressRule /></Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                    <TextBlock Text="Enter a valid email address." Style="{StaticResource InlineError}" />
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource GalleryDivider}">
                <StackPanel>
                    <TextBlock Text="Multiline" Style="{StaticResource GallerySection}" />
                    <TextBox Text="Review the examples at 125% scaling." Style="{StaticResource Neumorphism.Field}" Height="100"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="12,8"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Review notes" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GalleryDivider}">
                <StackPanel MaxWidth="350" HorizontalAlignment="Left">
                    <TextBlock Text="Disabled" Style="{StaticResource GallerySection}" />
                    <TextBox Text="Managed by your workspace" IsEnabled="False" Style="{StaticResource Neumorphism.Field}" AutomationProperties.Name="Workspace setting" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
