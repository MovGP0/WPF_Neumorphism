<UserControl x:Class="Neumorphism.WPF.Gallery.ListsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Neumorphism.WPF.Theming"
             xmlns:gallery="clr-namespace:Neumorphism.WPF.Gallery">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2,12,14,24">
            <UniformGrid Columns="2">
                <StackPanel Margin="4,0,16,0">
                    <TextBlock x:Name="SingleLabel" Text="Single selection" Style="{StaticResource GallerySection}" />
                    <ContentControl Style="{StaticResource Neumorphism.ListSurface}" Margin="1,3,5,9">
                        <ListBox x:Name="Rooms" Style="{StaticResource Neumorphism.ListBox}" SelectedIndex="0"
                                 AutomationProperties.LabeledBy="{Binding ElementName=SingleLabel}">
                            <ListBoxItem Content="Studio" /><ListBoxItem Content="Workshop" /><ListBoxItem Content="Library" /><ListBoxItem Content="Meeting room" />
                        </ListBox>
                    </ContentControl>
                </StackPanel>
                <StackPanel Margin="4,0,8,0">
                    <TextBlock x:Name="DetailsLabel" Text="Details and multi-selection" Style="{StaticResource GallerySection}" />
                    <ContentControl Style="{StaticResource Neumorphism.ListSurface}" Margin="1,3,5,9">
                        <ListView x:Name="Assets" Style="{StaticResource Neumorphism.ListView}" SelectionMode="Extended" SelectedIndex="0"
                                  AutomationProperties.LabeledBy="{Binding ElementName=DetailsLabel}">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource Neumorphism.ListColumn}">
                                    <GridViewColumn Header="Item" Width="135" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="State" Width="90" DisplayMemberBinding="{Binding State}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </ContentControl>
                    <TextBlock Text="Use Ctrl or Shift to select more than one item." Style="{StaticResource SupportingText}" Margin="0,10,0,0" />
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
