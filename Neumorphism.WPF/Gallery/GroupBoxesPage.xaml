<UserControl x:Class="Neumorphism.WPF.Gallery.GroupBoxesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Neumorphism.WPF.Theming"
             xmlns:gallery="clr-namespace:Neumorphism.WPF.Gallery">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2,12,14,24">
            <TextBlock Text="Group related controls" Style="{StaticResource GallerySection}" />
            <UniformGrid Columns="2">
                <GroupBox Header="Project details" Style="{StaticResource Neumorphism.GroupBox}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Name" Style="{StaticResource SupportingText}" Margin="0,0,0,6" />
                        <TextBox Text="Studio refresh" Style="{StaticResource Neumorphism.Field}" AutomationProperties.Name="Project name" />
                        <TextBlock Text="Reference" Style="{StaticResource SupportingText}" Margin="0,12,0,6" />
                        <TextBox Text="PRJ-204" IsReadOnly="True" Style="{StaticResource Neumorphism.Field}" AutomationProperties.Name="Project reference" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Delivery preferences" Style="{StaticResource Neumorphism.InsetGroupBox}">
                    <StackPanel>
                        <TextBlock Text="Choose a delivery channel." Style="{StaticResource SupportingText}" Margin="0,0,0,8" />
                        <ComboBox Style="{StaticResource Neumorphism.ComboBox}" SelectedIndex="0" AutomationProperties.Name="Delivery channel">
                            <ComboBoxItem Content="Email" /><ComboBoxItem Content="Workspace inbox" />
                        </ComboBox>
                        <ToggleButton Content="Include a summary" IsChecked="True" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </StackPanel>
                </GroupBox>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
