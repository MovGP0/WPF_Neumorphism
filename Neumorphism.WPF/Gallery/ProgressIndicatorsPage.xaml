<UserControl x:Class="Neumorphism.WPF.Gallery.ProgressIndicatorsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Neumorphism.WPF.Theming"
             xmlns:gallery="clr-namespace:Neumorphism.WPF.Gallery">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2,12,14,24">
            <TextBlock x:Name="DownloadLabel" Text="Determinate progress" Style="{StaticResource GallerySection}" />
            <DockPanel>
                <theme:ProgressRing x:Name="Ring" DockPanel.Dock="Right" Width="72" Height="72" Margin="24,0,4,0"
                                    Value="{Binding Value, ElementName=Meter}" AutomationProperties.Name="Circular progress" />
                <StackPanel>
                    <TextBlock Text="{Binding Value, ElementName=Meter, StringFormat='Completed {0:0}%'}"
                               Style="{StaticResource SupportingText}" Margin="0,0,0,8" />
                    <ProgressBar x:Name="Meter" Value="42" Style="{StaticResource Neumorphism.ProgressBar}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=DownloadLabel}" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="Advance" Click="Advance_Click" Margin="4,4,12,4" />
                        <Button Content="Reset" Click="Reset_Click" Style="{StaticResource Neumorphism.TextButton}" Margin="4" />
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource GalleryDivider}">
                <StackPanel>
                    <TextBlock Text="Indeterminate progress" Style="{StaticResource GallerySection}" />
                    <TextBlock Text="Checking for updates…" Style="{StaticResource SupportingText}" Margin="0,0,0,8" />
                    <ProgressBar IsIndeterminate="True" Style="{StaticResource Neumorphism.ProgressBar}" AutomationProperties.Name="Checking for updates" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
