<UserControl x:Class="Neumorphism.WPF.Gallery.CardsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CardVariantHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <UniformGrid Columns="2" Margin="0,8,12,0" VerticalAlignment="Top">
            <DockPanel Margin="12,4,12,6">
                <TextBlock DockPanel.Dock="Top" Text="Raised" Style="{StaticResource CardVariantHeading}" />
                <ContentControl x:Name="RaisedCard" Style="{StaticResource Neumorphism.RaisedCard}">
                    <DockPanel>
                        <ToggleButton x:Name="DetailsToggle" DockPanel.Dock="Bottom" HorizontalAlignment="Left"
                                      MinWidth="112" Margin="0,12,0,0">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                    <Setter Property="Content" Value="Show details" />
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Content" Value="Hide details" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <StackPanel>
                            <TextBlock Text="Studio review" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="ReviewSummary" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SupportingText}">
                                        <Setter Property="Text" Value="Review the latest layout and share feedback." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=DetailsToggle}" Value="True">
                                                <Setter Property="Text" Value="Wed, 10:30 AM · Studio 2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </ContentControl>
            </DockPanel>
            <DockPanel Margin="12,4,12,6">
                <TextBlock DockPanel.Dock="Top" Text="Filled" Style="{StaticResource CardVariantHeading}" />
                <ContentControl x:Name="FilledCard" Style="{StaticResource Neumorphism.FilledCard}">
                    <StackPanel>
                        <TextBlock Text="Release checklist" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="2 of 3 complete" Margin="0,6,0,10" Style="{StaticResource SupportingText}" />
                        <TextBlock Text="✓  Assets reviewed" AutomationProperties.Name="Assets reviewed, complete" Margin="0,0,0,4" />
                        <TextBlock Text="✓  Contrast checked" AutomationProperties.Name="Contrast checked, complete" Margin="0,0,0,4" />
                        <TextBlock Text="○  Confirm keyboard order" AutomationProperties.Name="Confirm keyboard order, pending" />
                    </StackPanel>
                </ContentControl>
            </DockPanel>
            <DockPanel Margin="12,4,12,6">
                <TextBlock DockPanel.Dock="Top" Text="Outlined" Style="{StaticResource CardVariantHeading}" />
                <ContentControl x:Name="OutlinedCard" Style="{StaticResource Neumorphism.OutlinedCard}">
                    <DockPanel>
                        <ToggleButton x:Name="PinToggle" DockPanel.Dock="Bottom" HorizontalAlignment="Left" MinWidth="82" Margin="0,12,0,0">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                    <Setter Property="Content" Value="Pin" />
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Content" Value="Pinned" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <StackPanel>
                            <TextBlock Text="Design reference" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Spacing and typography decisions for the current iteration."
                                       Style="{StaticResource SupportingText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>
                </ContentControl>
            </DockPanel>
            <DockPanel Margin="12,4,12,6">
                <TextBlock DockPanel.Dock="Top" Text="Recessed" Style="{StaticResource CardVariantHeading}" />
                <ContentControl x:Name="RecessedCard" Style="{StaticResource Neumorphism.RecessedCard}">
                    <StackPanel>
                        <TextBlock x:Name="NoteHeading" Text="Quick note" Style="{StaticResource CardTitle}" />
                        <TextBox x:Name="Note" Text="Check spacing at 125%." Style="{StaticResource ShellInput}"
                                 Margin="0,6,0,8" AutomationProperties.LabeledBy="{Binding ElementName=NoteHeading}" />
                        <Button x:Name="ClearNote" Content="Clear" HorizontalAlignment="Left" Click="ClearNote_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Neumorphism.OutlineButton}">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=Note}" Value="">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ContentControl>
            </DockPanel>
        </UniformGrid>
    </ScrollViewer>
</UserControl>
