<UserControl x:Class="Neumorphism.WPF.Gallery.NavigationBarsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Neumorphism.WPF.Theming"
             xmlns:gallery="clr-namespace:Neumorphism.WPF.Gallery">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2,12,14,24">
            <TextBlock Text="Bottom navigation" Style="{StaticResource GallerySection}" />
            <ContentControl Style="{StaticResource Neumorphism.RaisedCard}" Padding="0" Margin="3,2"
                            theme:SurfaceChrome.Elevation="{x:Static theme:SurfaceElevation.Level2}">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource MaterialDesign.Brush.OutlineVariant}" BorderThickness="0,1,0,0">
                        <ListBox x:Name="Navigation" Style="{StaticResource Neumorphism.NavigationBar}" HorizontalAlignment="Center"
                                 AutomationProperties.Name="Bottom navigation" ItemsSource="{x:Static gallery:GalleryDestination.All}" SelectedIndex="0" />
                    </Border>
                    <StackPanel MinHeight="130" Margin="22,18">
                        <TextBlock Text="{Binding SelectedItem.Name, ElementName=Navigation}" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedItem.Summary, ElementName=Navigation}" Style="{StaticResource SupportingText}" Margin="0,8,0,0" />
                    </StackPanel>
                </DockPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
