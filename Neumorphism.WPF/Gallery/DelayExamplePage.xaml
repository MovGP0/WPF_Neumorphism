<UserControl x:Class="Neumorphism.WPF.Gallery.DelayExamplePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gallery="clr-namespace:Neumorphism.WPF.Gallery">
    <UserControl.Resources>
        <ResourceDictionary Source="../Theming/DelayExampleStyles.xaml" />
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="2,12,14,24" MaxWidth="1240">
            <Border CornerRadius="14" Background="{DynamicResource DelayExample.Brush.Backdrop}" ClipToBounds="True">
                <Viewbox Stretch="Uniform">
                    <Grid Width="1132" Height="600">
                        <Border Width="1060" Height="440" CornerRadius="5" IsHitTestVisible="False"
                                Background="{DynamicResource DelayExample.Brush.Well}">
                            <Border.Effect>
                                <DropShadowEffect Color="#24354C" Direction="270" ShadowDepth="25" BlurRadius="43" Opacity=".58" />
                            </Border.Effect>
                        </Border>
                        <Grid x:Name="Faceplate" Width="1060" Height="440"
                              TextElement.Foreground="{DynamicResource DelayExample.Brush.Text}"
                              Background="{DynamicResource DelayExample.Brush.Face}"
                              AutomationProperties.Name="Afterimage stereo delay visual simulation">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,1060,440" RadiusX="5" RadiusY="5" />
                            </Grid.Clip>

                            <Canvas IsHitTestVisible="False">
                                <Ellipse Canvas.Left="292" Canvas.Top="38" Width="476" Height="404"
                                         Fill="{Binding Spill, RelativeSource={RelativeSource AncestorType=gallery:DelayExamplePage}}" />
                                <Path Data="M 0,249 H 402 C 427,249 435,270 458,270 H 602 C 625,270 633,249 658,249 H 1060 V 440 H 0 Z"
                                      Fill="{DynamicResource DelayExample.Brush.Deck}" />
                                <Ellipse Canvas.Left="174" Canvas.Top="270" Width="712" Height="150"
                                         Fill="{DynamicResource DelayExample.Brush.DeckLight}" />
                                <Path Data="M 0,424 H 342 C 370,424 375,411 396,411 H 626 C 650,411 654,424 682,424 H 1060 V 440 H 0 Z"
                                      Fill="{DynamicResource DelayExample.Brush.LowerLip}" />
                                <Path Data="M 0,250 H 402 C 427,250 435,271 458,271 H 602 C 625,271 633,250 658,250 H 1060"
                                      Stroke="{DynamicResource DelayExample.Brush.Well}" StrokeThickness="4" />
                                <Path Data="M 0,252 H 402 C 427,252 435,273 458,273 H 602 C 625,273 633,252 658,252 H 1060"
                                      Stroke="{DynamicResource DelayExample.Brush.Edge}" StrokeThickness="1.2" />
                            </Canvas>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="51" />
                                    <RowDefinition Height="198" />
                                    <RowDefinition Height="191" />
                                </Grid.RowDefinitions>

                                <Border Margin="14,0" BorderBrush="{DynamicResource DelayExample.Brush.Rule}" BorderThickness="0,0,0,1">
                                    <DockPanel Margin="2,0" VerticalAlignment="Center">
                                        <TextBlock Text="a f t e r i m a g e" FontFamily="Consolas" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DelayExample.Brush.Muted}" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Right" Text="STEREO DELAY" FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource DelayExample.Brush.Muted}" VerticalAlignment="Center" />
                                        <Border DockPanel.Dock="Right" Style="{StaticResource DelaySwitchFrame}" Margin="0,0,14,0">
                                            <ToggleButton x:Name="Bypass" Content="BYPASS" Style="{StaticResource DelaySwitch}" Padding="10,2"
                                                          Checked="Bypass_Changed" Unchecked="Bypass_Changed" />
                                        </Border>
                                        <Border />
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Row="1" Margin="12,12,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="343" />
                                        <ColumnDefinition Width="350" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="PATTERN" Style="{StaticResource DelaySideLabel}">
                                            <TextBlock.LayoutTransform><RotateTransform Angle="-90" /></TextBlock.LayoutTransform>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" Margin="9,5,0,0">
                                            <Border Style="{StaticResource DelaySwitchFrame}" HorizontalAlignment="Center">
                                                <UniformGrid Columns="2" Width="168" KeyboardNavigation.TabNavigation="Once">
                                                    <RadioButton x:Name="DualPattern" Content="DUAL" GroupName="Pattern"
                                                                 Style="{StaticResource DelaySwitch}" Checked="Pattern_Changed" />
                                                    <RadioButton x:Name="SequencePattern" Content="SEQUENCE" GroupName="Pattern" IsChecked="True"
                                                                 Style="{StaticResource DelaySwitch}" Checked="Pattern_Changed" />
                                                </UniformGrid>
                                            </Border>
                                            <UniformGrid x:Name="Steps" Columns="8" Margin="17,28,4,13"
                                                         ToggleButton.Checked="Pattern_Changed" ToggleButton.Unchecked="Pattern_Changed">
                                                <ToggleButton Style="{StaticResource DelayStep}" AutomationProperties.Name="Sequence step 1" IsChecked="True" />
                                                <ToggleButton Style="{StaticResource DelayStep}" AutomationProperties.Name="Sequence step 2" IsChecked="True" />
                                                <ToggleButton Style="{StaticResource DelayStep}" AutomationProperties.Name="Sequence step 3" />
                                                <ToggleButton Style="{StaticResource DelayStep}" AutomationProperties.Name="Sequence step 4" IsChecked="True" />
                                                <ToggleButton Style="{StaticResource DelayStep}" AutomationProperties.Name="Sequence step 5" />
                                                <ToggleButton Style="{StaticResource DelayStep}" AutomationProperties.Name="Sequence step 6" />
                                                <ToggleButton Style="{StaticResource DelayStep}" AutomationProperties.Name="Sequence step 7" />
                                                <ToggleButton Style="{StaticResource DelayStep}" AutomationProperties.Name="Sequence step 8" />
                                            </UniformGrid>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="MODE" Style="{StaticResource DelayLabel}" Margin="0,0,9,0" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource DelaySwitchFrame}">
                                                    <UniformGrid Columns="2" Width="101" KeyboardNavigation.TabNavigation="Once">
                                                        <RadioButton x:Name="Loop" Content="LOOP" GroupName="Transport" IsChecked="True"
                                                                     Style="{StaticResource DelaySwitch}" Padding="4,1" Checked="Transport_Changed" />
                                                        <RadioButton x:Name="Once" Content="ONCE" GroupName="Transport"
                                                                     Style="{StaticResource DelaySwitch}" Padding="4,1" Checked="Transport_Changed" />
                                                    </UniformGrid>
                                                </Border>
                                                <TextBlock Text="STEPS" Style="{StaticResource DelayLabel}" Margin="19,0,8,0" VerticalAlignment="Center" />
                                                <Button x:Name="StepCount" Content="5 ↕" Style="{StaticResource DelayAction}" Padding="9,1"
                                                        AutomationProperties.Name="Change sequence step count" Click="StepCount_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="178" />
                                            <ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="6,22,0,0">
                                            <gallery:DelayDial x:Name="ModRate" Tag="MOD RATE" Unit="Hz" FontSize="21"
                                                               Minimum=".1" Maximum="8" Value="1" TickFrequency=".1" SmallChange=".1"
                                                               Style="{StaticResource DelayReadout}" AutomationProperties.Name="Modulation rate" ValueChanged="Dial_ValueChanged" />
                                            <gallery:DelayDial x:Name="Modulation" Tag="MOD AMT" Unit="%" FontSize="21" Margin="0,16,0,0"
                                                               Maximum="100" Value="20"
                                                               Style="{StaticResource DelayReadout}" AutomationProperties.Name="Modulation amount" ValueChanged="Dial_ValueChanged" />
                                        </StackPanel>

                                        <Canvas Grid.Column="1" Width="176" Height="165" VerticalAlignment="Top" IsHitTestVisible="False">
                                            <Path x:Name="ContourGlow" Stroke="{Binding Accent, RelativeSource={RelativeSource AncestorType=gallery:DelayExamplePage}}"
                                                  StrokeThickness="4.6" Opacity=".76" StrokeLineJoin="Round">
                                                <Path.Effect><BlurEffect Radius="5.5" /></Path.Effect>
                                            </Path>
                                            <Path x:Name="Contour" Data="{Binding Data, ElementName=ContourGlow}"
                                                  Stroke="{Binding Accent, RelativeSource={RelativeSource AncestorType=gallery:DelayExamplePage}}"
                                                  StrokeThickness="1.9" StrokeLineJoin="Round" />
                                            <Path Data="{Binding Data, ElementName=ContourGlow}"
                                                  Stroke="{Binding Core, RelativeSource={RelativeSource AncestorType=gallery:DelayExamplePage}}"
                                                  StrokeThickness=".9" StrokeLineJoin="Round" />
                                        </Canvas>
                                        <DockPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="14,0,14,-11">
                                            <Button AutomationProperties.Name="Previous delay mode" Style="{StaticResource DelayModeArrow}" Click="PreviousMode_Click">
                                                <Path Data="M 5,0 L 0,5 5,10" StrokeThickness="1.25" Stroke="{DynamicResource DelayExample.Brush.Muted}" />
                                            </Button>
                                            <Button DockPanel.Dock="Right" AutomationProperties.Name="Next delay mode"
                                                    Style="{StaticResource DelayModeArrow}" Click="NextMode_Click">
                                                <Path Data="M 0,0 L 5,5 0,10" StrokeThickness="1.25" Stroke="{DynamicResource DelayExample.Brush.Muted}" />
                                            </Button>
                                            <TextBlock x:Name="ModeName" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       AutomationProperties.LiveSetting="Polite" />
                                        </DockPanel>

                                        <StackPanel Grid.Column="2" Margin="2,45,0,0">
                                            <Border Style="{StaticResource DelaySwitchFrame}" HorizontalAlignment="Center">
                                                <ToggleButton x:Name="Freeze" Content="FREEZE" Style="{StaticResource DelaySwitch}"
                                                              AutomationProperties.Name="Freeze visual preview" Padding="9,3"
                                                              Checked="Transport_Changed" Unchecked="Transport_Changed" />
                                            </Border>
                                            <gallery:DelayDial x:Name="Diffusion" Tag="DIFFUSION" Unit="%" FontSize="21" Margin="0,33,0,0"
                                                               Maximum="100" Value="0" Style="{StaticResource DelayReadout}"
                                                               AutomationProperties.Name="Diffusion" ValueChanged="Dial_ValueChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="33" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="12,5,7,0">
                                            <Border Style="{StaticResource DelaySwitchFrame}" HorizontalAlignment="Center">
                                                <UniformGrid Columns="2" Width="128" KeyboardNavigation.TabNavigation="Once">
                                                    <RadioButton x:Name="PreFilter" Content="PRE" GroupName="Filter"
                                                                 Style="{StaticResource DelaySwitch}" Checked="Filter_Changed" />
                                                    <RadioButton x:Name="PostFilter" Content="POST" GroupName="Filter" IsChecked="True"
                                                                 Style="{StaticResource DelaySwitch}" Checked="Filter_Changed" />
                                                </UniformGrid>
                                            </Border>
                                            <Grid Margin="0,10,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <gallery:DelayDial x:Name="LowCut" Tag="LOW CUT" Unit="Hz" FontSize="21"
                                                                   Minimum="20" Maximum="2000" Value="449" SmallChange="10" TickFrequency="1"
                                                                   Style="{StaticResource DelayReadout}" AutomationProperties.Name="Low cut" ValueChanged="Dial_ValueChanged" />
                                                <Viewbox Grid.Column="1" Margin="2,0" Stretch="Uniform">
                                                    <Canvas Width="132" Height="55" IsHitTestVisible="False">
                                                        <Path Data="M 1,2 V 41 H 131 M 18,2 V 41 M 38,2 V 41 M 66,2 V 41 M 94,2 V 41 M 114,2 V 41 M 131,2 V 41"
                                                              Stroke="{DynamicResource DelayExample.Brush.Edge}" StrokeThickness=".6" />
                                                        <Path x:Name="FilterCurve" Stroke="{DynamicResource DelayExample.Brush.Muted}" StrokeThickness="1" />
                                                        <TextBlock Canvas.Top="43" Text="20    100     1k     5k  20k" FontFamily="Consolas" FontSize="8.7"
                                                                   Foreground="{DynamicResource DelayExample.Brush.Muted}" />
                                                    </Canvas>
                                                </Viewbox>
                                                <gallery:DelayDial x:Name="HighCut" Grid.Column="2" Tag="HIGH CUT" Unit="kHz" FontSize="21"
                                                                   Minimum="1" Maximum="20" Value="20"
                                                                   Style="{StaticResource DelayReadout}" AutomationProperties.Name="High cut" ValueChanged="Dial_ValueChanged" />
                                            </Grid>
                                            <Border BorderBrush="{DynamicResource DelayExample.Brush.Rule}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                                <UniformGrid Columns="4">
                                                    <gallery:DelayDial x:Name="LowDamping" Tag="LOW DAMP" Unit="%" FontSize="16" Value="0"
                                                                       Style="{StaticResource DelayReadout}" AutomationProperties.Name="Low damping" ValueChanged="Dial_ValueChanged" />
                                                    <gallery:DelayDial x:Name="LowDampFrequency" Tag="FREQ" Unit="Hz" FontSize="16"
                                                                       Minimum="20" Maximum="700" Value="20" TickFrequency="10" SmallChange="10"
                                                                       Style="{StaticResource DelayReadout}" AutomationProperties.Name="Low damping frequency" ValueChanged="Dial_ValueChanged" />
                                                    <gallery:DelayDial x:Name="HighDamping" Tag="HIGH DAMP" Unit="%" FontSize="16" Value="54"
                                                                       Style="{StaticResource DelayReadout}" AutomationProperties.Name="High damping" ValueChanged="Dial_ValueChanged" />
                                                    <gallery:DelayDial x:Name="HighDampFrequency" Tag="FREQ" Unit="kHz" FontSize="16"
                                                                       Minimum="1" Maximum="20" Value="4" TickFrequency=".1" SmallChange=".1"
                                                                       Style="{StaticResource DelayReadout}" AutomationProperties.Name="High damping frequency" ValueChanged="Dial_ValueChanged" />
                                                </UniformGrid>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="FILTERS" Style="{StaticResource DelaySideLabel}">
                                            <TextBlock.LayoutTransform><RotateTransform Angle="90" /></TextBlock.LayoutTransform>
                                        </TextBlock>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,22,0,26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="252" />
                                        <ColumnDefinition Width="502" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="{DynamicResource DelayExample.Brush.Bay}" CornerRadius="0,12,12,0" Padding="11,9,18,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="35" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="GROOVE" Style="{StaticResource DelaySideLabel}">
                                                <TextBlock.LayoutTransform><RotateTransform Angle="-90" /></TextBlock.LayoutTransform>
                                            </TextBlock>
                                            <gallery:DelayDial x:Name="Swing" Grid.Column="1" Tag="SWING" Unit="%" MinHeight="72" Value="50" ShowAccent="False"
                                                               Style="{StaticResource DelayKnob}" AutomationProperties.Name="Swing" ValueChanged="Dial_ValueChanged" />
                                            <gallery:DelayDial x:Name="Offset" Grid.Column="2" Tag="OFFSET" Unit="ms" MinHeight="72"
                                                               Minimum="-75" Maximum="75" Value="0" ShowAccent="False"
                                                               Style="{StaticResource DelayKnob}" AutomationProperties.Name="Offset" ValueChanged="Dial_ValueChanged" />
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Column="1" Margin="13,0,14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55" />
                                            <ColumnDefinition Width="111" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="57" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Canvas IsHitTestVisible="False">
                                            <Path Data="M 27.5,93 V 117 Q 27.5,133 42,133 H 83"
                                                  Stroke="{DynamicResource DelayExample.Brush.Edge}" />
                                        </Canvas>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,21">
                                            <TextBlock Text="SYNC" Style="{StaticResource DelayLabel}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                            <ToggleButton x:Name="Sync" IsChecked="True" Style="{StaticResource DelayLamp}"
                                                          AutomationProperties.Name="Tempo sync" Checked="Sync_Changed" Unchecked="Sync_Changed" />
                                        </StackPanel>
                                        <gallery:DelayDial x:Name="DelayTime" Grid.Column="1" Tag="DELAY" Unit="ms" MinHeight="102"
                                                           Minimum="80" Maximum="800" Value="360" TickFrequency="10" SmallChange="10" LargeChange="60"
                                                           Style="{StaticResource DelayKnob}" AutomationProperties.Name="Delay time" ValueChanged="Dial_ValueChanged" />
                                        <gallery:DelayDial x:Name="WidthDial" Grid.Column="2" Tag="WIDTH" Unit="%" MinHeight="48" Maximum="150" Value="100"
                                                           Style="{StaticResource DelayKnob}" AutomationProperties.Name="Stereo width" ValueChanged="Dial_ValueChanged" />
                                        <gallery:DelayDial x:Name="Mix" Grid.Column="3" Tag="MIX" Unit="%" MinHeight="72" Value="50"
                                                           Style="{StaticResource DelayKnob}" AutomationProperties.Name="Mix" ValueChanged="Dial_ValueChanged" />
                                        <gallery:DelayDial x:Name="Pan" Grid.Column="4" Tag="PAN" MinHeight="48" Minimum="-100" Maximum="100" Value="0" ShowAccent="False"
                                                           Style="{StaticResource DelayKnob}" AutomationProperties.Name="Pan" ValueChanged="Dial_ValueChanged" />
                                        <gallery:DelayDial x:Name="Feedback" Grid.Column="5" Tag="FEEDBACK" Unit="%" MinHeight="102" Maximum="95" Value="50"
                                                           Style="{StaticResource DelayKnob}" AutomationProperties.Name="Feedback" ValueChanged="Dial_ValueChanged" />
                                    </Grid>

                                    <Border Grid.Column="2" Background="{DynamicResource DelayExample.Brush.Bay}" CornerRadius="12,0,0,12" Padding="16,9,10,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="37" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,4,0,0">
                                                <ToggleButton x:Name="Sidechain" Style="{StaticResource DelayLamp}"
                                                              AutomationProperties.Name="External sidechain" Checked="Filter_Changed" Unchecked="Filter_Changed" />
                                                <TextBlock Text="EXT SC" Style="{StaticResource DelayLabel}" HorizontalAlignment="Center" Margin="0,4,0,9" />
                                                <Button x:Name="Target" Content="POST  ⌄" Style="{StaticResource DelayAction}" Padding="10,3"
                                                        AutomationProperties.Name="Change ducker target" Click="Target_Click" />
                                                <TextBlock Text="TARGET" Style="{StaticResource DelayLabel}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                            </StackPanel>
                                            <gallery:DelayDial x:Name="DuckerAmount" Grid.Column="1" Tag="AMOUNT" Unit="%" MinHeight="74" Value="84" ShowScale="True"
                                                               Style="{StaticResource DelayKnob}" AutomationProperties.Name="Ducker amount" ValueChanged="Dial_ValueChanged" />
                                            <gallery:DelayDial x:Name="DuckerRelease" Grid.Column="2" Tag="RELEASE" Unit="%" MinHeight="50" Value="50"
                                                               Style="{StaticResource DelayKnob}" AutomationProperties.Name="Ducker release" ValueChanged="Dial_ValueChanged" />
                                            <TextBlock Grid.Column="3" Text="DUCKER" Style="{StaticResource DelaySideLabel}">
                                                <TextBlock.LayoutTransform><RotateTransform Angle="90" /></TextBlock.LayoutTransform>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Viewbox>
            </Border>
            <TextBlock Text="Visual simulation" Style="{StaticResource SupportingText}" HorizontalAlignment="Right" Margin="0,6,2,0" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
