<UserControl x:Class="Neumorphism.WPF.Gallery.SnackbarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Neumorphism.WPF.Theming"
             xmlns:gallery="clr-namespace:Neumorphism.WPF.Gallery">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2,12,14,24">
            <TextBlock Text="Try a status message" Style="{StaticResource GallerySection}" />
            <WrapPanel>
                <Button x:Name="ShowStatus" Content="Show timed message" Click="ShowStatus_Click" Margin="4,4,12,4" />
                <Button x:Name="ShowUndo" Content="Show undo action" Click="ShowUndo_Click" Margin="4,4,12,4" />
            </WrapPanel>
            <Grid Height="210" Margin="5,0,12,4">
                <ContentControl x:Name="Notice" Style="{StaticResource Neumorphism.Snackbar}" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="×" AutomationProperties.Name="Dismiss notification"
                                Style="{StaticResource Neumorphism.TextButton}" MinWidth="36" Padding="5" MinHeight="36" Click="Dismiss_Click" />
                        <Button x:Name="Undo" DockPanel.Dock="Right" Content="Undo" Style="{StaticResource Neumorphism.TextButton}"
                                Click="Undo_Click" MinHeight="36" Margin="4,0" />
                        <TextBlock x:Name="Message" Text="Draft archived." Margin="0,0,8,0" MinWidth="160"
                                   TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                </ContentControl>
            </Grid>
            <TextBlock x:Name="Feedback" Style="{StaticResource SupportingText}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
