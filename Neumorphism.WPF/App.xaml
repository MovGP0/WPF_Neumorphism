<Application x:Class="Neumorphism.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theming/ShellStyles.xaml" />
                <ResourceDictionary Source="Theming/ButtonStyles.xaml" />
                <ResourceDictionary Source="Theming/CardStyles.xaml" />
                <ResourceDictionary Source="Theming/ScrollBarStyles.xaml" />
                <ResourceDictionary Source="Theming/ChipsStyles.xaml" />
                <ResourceDictionary Source="Theming/ComboBoxesStyles.xaml" />
                <ResourceDictionary Source="Theming/DataGridsStyles.xaml" />
                <ResourceDictionary Source="Theming/ExpanderStyles.xaml" />
                <ResourceDictionary Source="Theming/FieldsStyles.xaml" />
                <ResourceDictionary Source="Theming/GroupBoxesStyles.xaml" />
                <ResourceDictionary Source="Theming/ListsStyles.xaml" />
                <ResourceDictionary Source="Theming/MenusAndToolBarsStyles.xaml" />
                <ResourceDictionary Source="Theming/NavigationBarsStyles.xaml" />
                <ResourceDictionary Source="Theming/NavigationRailStyles.xaml" />
                <ResourceDictionary Source="Theming/PickersStyles.xaml" />
                <ResourceDictionary Source="Theming/ProgressIndicatorsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
