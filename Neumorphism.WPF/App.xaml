             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theming/ShellStyles.xaml" />
                <ResourceDictionary Source="Theming/ButtonStyles.xaml" />
                <ResourceDictionary Source="Theming/CardStyles.xaml" />
                <ResourceDictionary Source="Theming/ScrollBarStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
